{
  "name": "career-application-kit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:portfolio",
    "dev:portfolio": "vite --host 127.0.0.1",
    "dev:labs": "vite --config vite.labs.config.js --host 127.0.0.1",
    "dev:timber": "vite --config vite.timber.config.js --host 127.0.0.1",
    "test": "node scripts/validate_project_manifest.mjs && node --test tests/*.test.mjs",
    "build": "pnpm run test && pnpm run build:portfolio && pnpm run build:labs && pnpm run build:timber",
    "build:site": "pnpm run build && node scripts/assemble_cloudflare_site.mjs",
    "site:assemble": "node scripts/assemble_cloudflare_site.mjs",
    "build:portfolio": "vite build",
    "build:labs": "vite build --config vite.labs.config.js",
    "build:timber": "vite build --config vite.timber.config.js",
    "preview": "vite preview --host 127.0.0.1",
    "preview:labs": "vite preview --config vite.labs.config.js --host 127.0.0.1",
    "preview:timber": "vite preview --config vite.timber.config.js --host 127.0.0.1"
  },
  "dependencies": {
    "@react-spring/web": "^10.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "framer-motion": "^11.15.0",
    "gsap": "^3.12.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
