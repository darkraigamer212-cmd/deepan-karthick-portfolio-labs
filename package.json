{
  "name": "career-application-kit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:portfolio",
    "dev:portfolio": "vite --host 127.0.0.1",
    "dev:labs": "vite --config vite.labs.config.js --host 127.0.0.1",
    "test": "node scripts/validate_project_manifest.mjs",
    "build": "pnpm run test && pnpm run build:portfolio && pnpm run build:labs",
    "build:portfolio": "vite build",
    "build:labs": "vite build --config vite.labs.config.js",
    "preview": "vite preview --host 127.0.0.1",
    "preview:labs": "vite preview --config vite.labs.config.js --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7",
    "typescript": "^5.7.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "framer-motion": "^11.15.0",
    "gsap": "^3.12.5"
  },
  "devDependencies": {}
}
